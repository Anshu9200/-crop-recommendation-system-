#include "crop.h"

string recommendCrop(float ph, float temperature, float rainfall,
                     float humidity, float moisture)
{
    if (ph >= 5.5 && ph <= 7.0 &&
        rainfall >= 200 &&
        humidity >= 70 &&
        temperature >= 20 && temperature <= 35 &&
        moisture >= 50)
    {
        return "Rice";
    }

    else if (ph >= 6.0 && ph <= 7.5 &&
             rainfall >= 50 && rainfall <= 100 &&
             temperature >= 18 && temperature <= 28)
    {
        return "Wheat";
    }

    else if (ph >= 5.5 && ph <= 7.5 &&
             rainfall >= 60 && rainfall <= 120 &&
             temperature >= 25)
    {
        return "Maize";
    }

    else if (ph >= 6.0 &&
             rainfall >= 400 &&
             temperature >= 20)
    {
        return "Sugarcane";
    }

    else if (ph >= 6.0 &&
             rainfall >= 100 && rainfall <= 150 &&
             temperature >= 25)
    {
        return "Cotton";
    }

    else if (ph >= 6.0 &&
             rainfall >= 80 && rainfall <= 120 &&
             temperature >= 22)
    {
        return "Soybean";
    }

    else
    {
        return "No suitable crop found";
    }
}
